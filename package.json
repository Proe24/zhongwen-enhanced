{
  "name": "zhongwen-enhanced",
  "version": "1.0.1",
  "description": "Chinese Pop-Up Dictionary with AI sentence breakdown (fork of Zhongwen)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Proe24/zhongwen-enhanced.git"
  },
  "keywords": [
    "Chinese",
    "Dictionary"
  ],
  "author": "Stephen Underwood",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/Proe24/zhongwen-enhanced/issues"
  },
  "homepage": "https://github.com/Proe24/zhongwen-enhanced#readme",
  "devDependencies": {
    "eslint": "^8.10.0",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "stylelint": "^14.5.3",
    "stylelint-config-recommended": "^7.0.0"
  },
  "stylelint": {
    "extends": "stylelint-config-recommended"
  },
  "scripts": {
    "lint": "eslint background.js content.js dict.js js/options.js js/storage.js js/theme-init.js js/wordlist.js js/zhuyin.js tools/*.js tests/*.cjs",
    "lint:fix": "npm run lint -- --fix",
    "csslint": "stylelint css/content.css css/wordlist.css css/zhongwen.css",
    "test": "node --test tests/*.test.cjs",
    "check": "npm run lint && npm run csslint && npm test"
  }
}
