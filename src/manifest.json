{
  "manifest_version": 3,
  "name": "Zhongwen Enhanced: Chinese Pop-up Dictionary",
  "short_name": "Zhongwen Enhanced",
  "version": "0.0.0",
  "author": "Stephen Underwood",
  "homepage_url": "https://github.com/Proe24/zhongwen-enhanced",
  "description": "Hover over Chinese for pinyin and meaning. Save words with their sentence, review them with spaced repetition. Offline and private.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "Zhongwen Enhanced",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "app/index.html#/settings",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus"
  ],
  "commands": {
    "toggle": {
      "suggested_key": {
        "default": "Alt+Z"
      },
      "description": "Turn lookups on or off"
    },
    "open-library": {
      "suggested_key": {
        "default": "Alt+Shift+Z"
      },
      "description": "Open your vocabulary"
    }
  }
}
